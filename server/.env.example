# Copia este archivo a .env y completa los valores.
# Nunca subas .env a git.

# Token de acceso — ver SUSCRIPCIONES.md: en pruebas usar el TEST del **Vendedor** test, no el de tu cuenta real.
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxx

# URL pública HTTPS del backend (Render, Railway, PythonAnywhere, etc.)
BACKEND_URL=https://tu-api.onrender.com

# Tras pagar, MP redirige aquí (local: /gracias en tu API)
FRONTEND_RETURN_URL=http://localhost:5001/gracias

# Obligatorio en local: MP exige https al crear suscripción (usa Render/ngrok + /gracias)
MP_PUBLIC_BACK_URL=https://tu-api.onrender.com/gracias

# Monto mensual en CLP
PLAN_AMOUNT_CLP=19990

# Opcional: ID de plan ya creado en MP (Developers → Suscripciones). Si falta, la API lo busca o crea uno.
# MP_PREAPPROVAL_PLAN_ID=e2c7174a6c7b46f7827dc93db4848b3e

# Secreto opcional para validar webhooks (genera uno aleatorio).
# También es la llave de las páginas privadas: /api/admin/usage y /api/admin/funnel,
# y por tanto de landing/stats.html?secret=…
WEBHOOK_SECRET=cambia-esto-por-un-secreto-largo

# Postgres gestionado (Neon) en producción. Si se deja vacío se usa SQLite en
# disco, que en Render free se borra cada vez que el servicio se duerme.
# Usa el host con -pooler para no agotar el límite de conexiones.
# DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.region.aws.neon.tech/telar?sslmode=require

# Orígenes que pueden llamar a /api/* desde el navegador. El valor por defecto ya
# incluye telarapp.cl y la app de escritorio; si defines esta variable a mano,
# incluye https://telarapp.cl o stats.html no podrá leer sus datos.
# ALLOWED_ORIGINS=https://telarapp.cl,https://www.telarapp.cl

# Contraseña del panel privado de uso en vivo (telarapp.cl/panel).
# Si queda vacía, el panel responde 503 y no expone nada.
PANEL_PASSWORD=cambia-esto-por-una-contrasena-larga
# Minutos sin latido tras los que un dispositivo deja de contar como «en línea»
PANEL_ONLINE_WINDOW_MIN=3

# Solo en tu Mac: activa Pro sin Mercado Pago (nunca en Render/producción)
SUBSCRIPTION_DEV_BYPASS=0
# DEV_PRO_EMAIL=tu@email.com

# Puerto local
PORT=5001
