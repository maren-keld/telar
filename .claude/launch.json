{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "telar-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["scripts/dev-server.sh"],
      "port": 1420
    },
    {
      "name": "telar-landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "landing"],
      "port": 4173
    },
    {
      "name": "subscription-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd server && python3 app.py"],
      "port": 5001
    }
  ]
}
