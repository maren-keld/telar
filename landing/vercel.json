{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/modules.html",
      "destination": "/modules",
      "permanent": true
    },
    {
      "source": "/tdah-adulto",
      "destination": "/blog/tdah-adulto",
      "permanent": true
    },
    {
      "source": "/trauma-herramientas",
      "destination": "/blog/trauma-herramientas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/panel",
      "destination": "https://telar-api-aim8.onrender.com/panel"
    },
    {
      "source": "/panel/login",
      "destination": "https://telar-api-aim8.onrender.com/panel/login"
    },
    {
      "source": "/api/admin/live",
      "destination": "https://telar-api-aim8.onrender.com/api/admin/live"
    },
    {
      "source": "/api/admin/landing",
      "destination": "https://telar-api-aim8.onrender.com/api/admin/landing"
    },
    {
      "source": "/api/admin/crm",
      "destination": "https://telar-api-aim8.onrender.com/api/admin/crm"
    },
    {
      "source": "/api/admin/crm/:path*",
      "destination": "https://telar-api-aim8.onrender.com/api/admin/crm/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/panel(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/api/admin(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
